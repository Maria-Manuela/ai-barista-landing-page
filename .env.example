# =============================================================================
# AI Barista — environment variables
# Copy this file to `.env.local` and fill in the values (that file is gitignored).
# =============================================================================

# --- Site ---------------------------------------------------------------------
# Local: http://localhost:3000  |  Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase -----------------------------------------------------------------
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- AI — Google Gemini (free tier) -------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
# Optional override (default in code: gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash
